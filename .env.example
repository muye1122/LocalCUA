# ============================================================
# LocalCUA 环境变量配置样例
# 复制本文件为 .env，按自己情况改，run.py 启动时会自动读取。
# 所有 CU_ 变量都会覆盖 config.yaml 里对应字段。
# ============================================================

# ---------- 方案 A：本地 Ollama（默认，需先装好 Ollama 并拉模型） ----------
# CU_PROVIDER=ollama
# CU_MODEL=qwen3vl:8b

# ---------- 方案 B：云端视觉模型（不用下 Ollama，今天就能跑） ----------
# 推荐通义千问 Qwen-VL（国内直连快、原生多模态）。
# 1) 去 https://dashscope.console.aliyun.com 开通「百炼」并创建 API Key
# 2) 把下面 YOUR_KEY 换成你的真实 key
# 3) 复制本文件为 .env 即可生效
CU_PROVIDER=openai
CU_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
CU_OPENAI_KEY=YOUR_KEY
CU_MODEL=qwen-vl-max-latest

# 其它可选云端（改上面三行即可）：
#   智谱 GLM-4V:   CU_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions  CU_MODEL=glm-4v-plus
#   OpenAI:        CU_OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions            CU_MODEL=gpt-4o

# ---------- 其它可调项（可选） ----------
# CU_MAX_STEPS=40
# CU_TEMP=0.1
